# Banco de dados
DB_URL=jdbc:postgresql://localhost:5432/dietas
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Autenticação
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-de-pelo-menos-256-bits
JWT_EXPIRATION_MS=3600000

# CORS — origens liberadas para o front (lista separada por vírgula).
# Em produção, use o domínio real (ex.: https://app.seudominio.com).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# LLM (Google Gemini)
GEMINI_API_KEY=coloque-sua-chave-aqui
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Front-end
VITE_API_BASE_URL=http://localhost:8080
